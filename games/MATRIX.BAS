10 MODE 7
20 DIM D%(12),L%(12)
30 FOR I%=0 TO 12
40 D%(I%)=-RND(25)
50 L%(I%)=5+RND(12)
60 NEXT
70 REPEAT
80 FOR I%=0 TO 12
90 X%=I%*3
100 Y%=D%(I%)
110 IF Y%<0 THEN 170
120 IF Y%>24 THEN 170
130 P%=&7C00+40*Y%+X%
140 ?P%=135
150 ?(P%+1)=64+RND(26)
160 ?(P%+2)=64+RND(26)
170 IF Y%<1 THEN 220
180 IF Y%>25 THEN 220
190 P%=&7C00+40*(Y%-1)
200 P%=P%+X%
210 ?P%=130
220 IF Y%<L%(I%) THEN 290
230 Z%=Y%-L%(I%)
240 IF Z%>24 THEN 290
250 P%=&7C00+40*Z%+X%
260 ?P%=130
270 ?(P%+1)=32
280 ?(P%+2)=32
290 D%(I%)=Y%+1
300 T%=L%(I%)+25
310 IF D%(I%)<T% THEN 350
320 D%(I%)=-RND(25)
330 L%(I%)=5+RND(12)
350 NEXT
360 UNTIL FALSE
